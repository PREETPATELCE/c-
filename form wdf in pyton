import csv
import os

def save_to_csv():
    print("--- User Registration (CSV Storage) ---")
    
    # 1. Collect inputs from the user
    name = input("Enter Name: ")
    email = input("Enter Email: ")
    phone = input("Enter Phone Number: ")
    
    filename = 'registrations.csv'
    
    # 2. Check if the file already exists (so we don't duplicate headers)
    file_exists = os.path.isfile(filename)
    
    # 3. Open the file in append mode ('a')
    with open(filename, mode='a', newline='', encoding='utf-8') as file:
        writer = csv.writer(file)
        
        # Write the header line only if the file is brand new
        if not file_exists:
            writer.writerow(['Name', 'Email', 'Phone Number'])
            
        # Write the user's data row
        writer.writerow([name, email, phone])
        
    print(f"\nSuccess! Data for '{name}' has been saved to {filename}.")

if __name__ == "__main__":
    save_to_csv()
